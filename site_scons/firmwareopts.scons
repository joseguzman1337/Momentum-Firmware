Import("ENV")


if ENV["DEBUG"] and ENV["IS_BASE_FIRMWARE"]:
    ENV.Append(
        CPPDEFINES=[
            "FURI_DEBUG",
            "NDEBUG",
        ],
        CCFLAGS=[
            "-Oz" if ENV["COMPACT"] else "-Og",
        ],
    )
elif ENV["COMPACT"]:
    ENV.Append(
        CPPDEFINES=[
            "FURI_NDEBUG",
            "FURI_COMPACT_LOGS",
            "NDEBUG",
        ],
        CCFLAGS=[
            "-Oz",
        ],
    )
else:
    ENV.Append(
        CPPDEFINES=[
            "FURI_NDEBUG",
            "NDEBUG",
        ],
        CCFLAGS=[
            "-Og" if ENV["IS_BASE_FIRMWARE"] else "-Os",
        ],
    )

ENV.AppendUnique(
    LINKFLAGS=[
        "-specs=nano.specs",
        "-Wl,--gc-sections",
        "-Wl,--undefined=uxTopUsedPriority",
        "-Wl,--wrap,_malloc_r",
        "-Wl,--wrap,_free_r",
        "-Wl,--wrap,_calloc_r",
        "-Wl,--wrap,_realloc_r",
        "-n",
        "-Xlinker",
        "-Map=${TARGET}.map",
        "-T${LINKER_SCRIPT_PATH}",
    ],
)

if ENV["COMPACT"] and ENV["IS_BASE_FIRMWARE"]:
    ENV.AppendUnique(
        CCFLAGS=[
            "-flto",
            "-flto-partition=one",
            "-fno-fat-lto-objects",
            "-fipa-pta",
            "-fmerge-all-constants",
            "-fno-unwind-tables",
            "-fno-asynchronous-unwind-tables",
        ],
        LINKFLAGS=["-flto", "-flto-partition=one"],
    )


if ENV["FIRMWARE_BUILD_CFG"] == "updater":
    ENV.Append(
        IMAGE_BASE_ADDRESS="0x20000000",
        LINKER_SCRIPT_PATH=ENV["TARGET_CFG"].linker_script_ram,
    )
else:
    ENV.Append(
        IMAGE_BASE_ADDRESS="0x8000000",
        LINKER_SCRIPT_PATH=ENV["TARGET_CFG"].linker_script_flash,
        APP_LINKER_SCRIPT_PATH=ENV["TARGET_CFG"].linker_script_app,
    )
