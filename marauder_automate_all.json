{
  "name": "Automate All Wardriving Pipeline",
  "description": "End-to-end autonomous run: policy, daemon cycles, intel summary, alerts, and export",
  "steps": [
    {
      "cmd": "defcon auto on",
      "desc": "Enable adaptive DEFCON auto mode",
      "wait": 1
    },
    {
      "cmd": "defcon 3",
      "desc": "Start from elevated posture",
      "wait": 1
    },
    {
      "cmd": "daemon 20 8 -65 8",
      "desc": "Run autonomous ghost scan cycles",
      "wait": 1
    },
    {
      "cmd": "intel 1000",
      "desc": "Analyze risk trends and recommend posture",
      "wait": 1
    },
    {
      "cmd": "alerts 25",
      "desc": "Review recent HVT and DEFCON alerts",
      "wait": 1
    },
    {
      "cmd": "dbstats",
      "desc": "Summarize SQLite capture status",
      "wait": 1
    },
    {
      "cmd": "exportcsv wardriving_automate_all.csv 0",
      "desc": "Export all intelligence rows for downstream tooling",
      "wait": 1
    }
  ]
}
