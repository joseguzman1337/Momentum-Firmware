Import("env")

env.Append(
    CPPPATH=[
        "#/lib/mlib",
    ],
    SDK_HEADERS=[
        *(
            File(f"#/lib/mlib/m-{name}.h")
            for name in (
                "algo",
                "array",
                "bptree",
                "core",
                "deque",
                "dict",
                "list",
                "rbtree",
                "tuple",
                "variant",
            )
        ),
    ],
    CPPDEFINES=[
        '"M_MEMORY_FULL(...)=abort()"',
    ],
    # mlib is included from firmware translation units built with
    # -fsingle-precision-constant; its deliberate double arithmetic then
    # triggers GCC's double-promotion diagnostic.
    CCFLAGS=["-Wno-error=double-promotion"],
)
