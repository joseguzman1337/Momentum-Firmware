Import("env")

# Mbed TLS 4.x moved the crypto implementation to TF-PSA-Crypto and removed
# the public 3.x crypto API consumed by firmware and existing FAPs. Keep the
# prior implementation namespaced inside the 4.x submodule for ABI continuity.
legacy_mbedtls = "mbedtls/legacy-v3"

env.Append(
    CPPPATH=[
        f"#/lib/{legacy_mbedtls}/include",
        f"#/lib/{legacy_mbedtls}/library",
    ],
    SDK_HEADERS=[
        *(File(f"{legacy_mbedtls}/include/mbedtls/{header}.h") for header in (
            "aes", "des", "sha1", "sha256", "md5", "md", "ecdsa", "ecdh", "ecp"
        )),
        # File("mbedtls/include/mbedtls/sha1.h"),
    ],
    CPPDEFINES=[("MBEDTLS_CONFIG_FILE", '\\"mbedtls_cfg.h\\"')],
)


libenv = env.Clone(FW_LIB_NAME="mbedtls")
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CCFLAGS=[
        # Required for lib to be linkable with .faps
        "-mword-relocations",
        "-mlong-calls",
        # Crappy code :)
        "-Wno-redundant-decls",
    ],
)

# If we were to build full mbedtls, we would need to use this:
# sources = libenv.GlobRecursive("*.c*", "mbedtls/library")
# Otherwise, we can just use the files we need:
sources = [
    File(f"{legacy_mbedtls}/library/{source}.c")
    for source in (
        "aes", "asn1parse", "asn1write", "base64", "bignum", "bignum_core",
        "cipher", "cipher_wrap", "constant_time", "des", "dhm", "ecdh",
        "ecdsa", "ecp", "ecp_curves", "error", "gcm", "md", "md5", "oid",
        "platform_util", "ripemd160", "sha1", "sha256"
    )
]
Depends(sources, File("mbedtls_cfg.h"))


lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
