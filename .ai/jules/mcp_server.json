{
  "mcpServers": {
    "jules-async": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "LOG_DIR": "logs/jules",
        "AUTO_MERGE": "identity-metadata-only",
        "CONCURRENT_SESSIONS": "identity-metadata-only",
        "YOLO_MODE": "identity-metadata-only",
        "MCP_AGENT_ROLE": "jules-async",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the jules-async identity; legacy async, concurrency, and automation labels are metadata only"
    }
  }
}
