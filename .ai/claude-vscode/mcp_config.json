{
  "mcpServers": {
    "claude-vscode-bridge": {
      "command": "python3",
      "args": [".ai/claude-vscode/scripts/mcp_bridge.py"],
      "env": {
        "WORKSPACE_ROOT": ".",
        "LOG_DIR": "logs/claude-vscode",
        "YOLO_MODE": "true"
      }
    },
    "momentum-codex": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "COORDINATION_MODE": "identity-metadata-only",
        "PRIMARY_AGENT": "identity-metadata-only",
        "MCP_AGENT_ROLE": "momentum-codex",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the momentum-codex identity; legacy coordination labels are metadata only"
    },
    "flipper-tools": {
      "command": "python3",
      "args": [".ai/tools/scripts/flipper_mcp.py"],
      "env": {
        "FBT_PATH": "./fbt",
        "TARGET": "f7"
      }
    },
    "firmware-analyzer": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "ANALYSIS_MODE": "identity-metadata-only",
        "MCP_AGENT_ROLE": "firmware-analyzer",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the firmware-analyzer identity; legacy realtime analysis label is metadata only and no firmware analysis is performed"
    }
  }
}
