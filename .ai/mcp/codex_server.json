{
    "mcpServers": {
        "codex_tools": {
            "command": "python3",
            "args": [
                ".ai/mcp/scripts/repo_agent_server.py"
            ],
            "env": {
                "PROJECT_ROOT": ".",
                "LOG_DIR": "logs/codex",
                "MCP_AGENT_ROLE": "codex-tools"
            },
            "trust": true,
            "description": "Read-only repository status compatibility adapter using the codex-tools identity; the legacy tools label is metadata only and it does not generate or modify code"
        },
        "github_integration": {
            "command": "python3",
            "args": [
                ".ai/mcp/scripts/repo_agent_server.py"
            ],
            "env": {
                "GH_TOKEN": "identity-metadata-only",
                "PROJECT_ROOT": ".",
                "MCP_AGENT_ROLE": "github-integration"
            },
            "trust": true,
            "description": "Read-only repository status compatibility adapter using the github-integration identity; the legacy GitHub label is metadata only and it does not call GitHub APIs"
        },
        "rag_knowledge": {
            "command": "python3",
            "args": [
                ".ai/mcp/scripts/rag_server.py"
            ],
            "env": {
                "VECTOR_STORE": ".ai/rag/embeddings",
                "KNOWLEDGE_BASE": ".ai/rag/shared_knowledge.json"
            },
            "trust": true,
            "description": "RAG system for shared knowledge across agents"
        },
        "agent_communication": {
            "command": "python3",
            "args": [
                ".ai/mcp/scripts/a2a_server.py"
            ],
            "env": {
                "MESSAGE_BUS": ".ai/workflows/message_bus.json"
            },
            "trust": true,
            "description": "Agent-to-agent communication protocol"
        },
        "warp_docs": {
            "url": "https://docs.warp.dev/~gitbook/mcp",
            "trust": true,
            "description": "Warp documentation MCP server for agent access to Warp docs"
        },
        "esp_mcp": {
            "command": "python3",
            "args": [
                "main.py"
            ],
            "env": {
                "IDF_PATH": "${HOME}/esp/esp-idf"
            },
            "cwd": ".ai/mcp/servers/esp_mcp",
            "trust": true,
            "description": "ESP-IDF MCP server for building, flashing, and testing ESP32 projects via tools like build_esp_project and flash_esp_project"
        },
        "strawberry_mcp": {
            "command": "python3",
            "args": [
                "main.py"
            ],
            "cwd": ".ai/mcp/servers/strawberry_mcp",
            "trust": true,
            "description": "Furi OS MCP server for Flipper Zero firmware operations (build, flash, clean) and WiFi Devboard deployment."
        },
        "flipper_recovery": {
            "command": "python3",
            "args": [
                "main.py"
            ],
            "cwd": ".ai/mcp/servers/flipper_recovery",
            "trust": true,
            "description": "Fail-closed Flipper recovery MCP with ELF boundary validation and explicitly confirmed flash operations."
        }
    }
}
