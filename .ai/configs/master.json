{
    "version": "1.0.0",
    "registry_notice": "Legacy provider, task, YOLO, automation, cloud, and security labels describe preserved identities and intended orchestration only. Registrations backed by repo_agent_server.py expose read-only local repository status tools and do not merge, push, close, scan, generate, call providers, or perform cloud actions.",
    "agents": {
        "codex": {
            "enabled": true,
            "mcp_capability": "Mixed registry; repo_agent_server-backed identities are read-only repository status adapters",
            "tasks_status": "intended orchestration metadata; not executed by the registered read-only MCP adapter",
            "mode": "yolo",
            "auto_approve": "identity-metadata-only",
            "log_dir": "logs/codex",
            "config": {
                "model": "gpt-5.2-codex",
                "full_auto": "identity-metadata-only",
                "search": true,
                "sandbox": "workspace-write"
            },
            "tasks": [
                "feature_implementation",
                "bug_fixes",
                "code_generation"
            ],
            "mcp_server": ".ai/mcp/codex_server.json"
        },
        "claude": {
            "enabled": true,
            "mcp_capability": "Read-only repository status compatibility adapter; security and automation labels are identity metadata only",
            "tasks_status": "intended orchestration metadata; not executed by the registered read-only MCP adapter",
            "mode": "yolo",
            "auto_approve": "identity-metadata-only",
            "log_dir": "logs/claude",
            "config": {
                "model": "claude-sonnet-4-5",
                "dangerously_skip_permissions": "identity-metadata-only",
                "output_format": "json"
            },
            "tasks": [
                "security_fixes",
                "code_review",
                "vulnerability_remediation"
            ],
            "mcp_server": ".ai/claude/mcp_server.json"
        },
        "gemini": {
            "enabled": true,
            "mcp_capability": "Read-only repository status compatibility adapter; architecture and super-agent labels are identity metadata only",
            "tasks_status": "intended orchestration metadata; not executed by the registered read-only MCP adapter",
            "mode": "yolo",
            "auto_approve": "identity-metadata-only",
            "log_dir": "logs/gemini",
            "config": {
                "model": "gemini-2.5-pro",
                "approval_mode": "yolo",
                "output_format": "json"
            },
            "tasks": [
                "architecture",
                "complex_refactoring",
                "performance_optimization"
            ],
            "mcp_server": ".ai/gemini/mcp_server.json"
        },
        "jules": {
            "enabled": true,
            "mcp_capability": "Read-only repository status compatibility adapter; async and PR labels are identity metadata only",
            "tasks_status": "intended orchestration metadata; not executed by the registered read-only MCP adapter",
            "mode": "async",
            "auto_approve": "identity-metadata-only",
            "log_dir": "logs/jules",
            "config": {
                "quota_aware": true,
                "max_concurrent": 15
            },
            "tasks": [
                "async_coding",
                "pr_generation",
                "multi_step_tasks"
            ],
            "mcp_server": ".ai/jules/mcp_server.json"
        },
        "warp": {
            "enabled": true,
            "mcp_capability": "Read-only repository status compatibility adapter; quality and automation labels are identity metadata only",
            "tasks_status": "intended orchestration metadata; not executed by the registered read-only MCP adapter",
            "mode": "yolo",
            "auto_approve": "identity-metadata-only",
            "log_dir": "logs/warp",
            "config": {
                "task_file": "warp_agent_tasks.md",
                "auto_execute": "identity-metadata-only",
                "batch_mode": true
            },
            "tasks": [
                "code_quality",
                "documentation",
                "analysis"
            ],
            "mcp_server": ".ai/warp/mcp_server.json"
        }
    },
    "super_agent": {
        "enabled": "identity-metadata-only",
        "runtime_status": "not implemented by any repo_agent_server-backed MCP registration",
        "name": "orchestrator",
        "capabilities": [
            "task_routing",
            "agent_coordination",
            "conflict_resolution",
            "priority_management"
        ],
        "decision_model": "gemini-2.5-pro",
        "rag_enabled": "identity-metadata-only"
    },
    "a2a_communication": {
        "enabled": true,
        "protocol": "mcp",
        "message_bus": ".ai/workflows/message_bus.json",
        "shared_context": ".ai/rag/shared_knowledge.json"
    },
    "rag": {
        "enabled": true,
        "vector_store": ".ai/rag/embeddings",
        "knowledge_base": [
            ".gemini/GEMINI.md",
            "ReadMe.md",
            "SKILL.md",
            "documentation/**/*.md"
        ],
        "embedding_model": "text-embedding-004",
        "chunk_size": 1000,
        "overlap": 200
    },
    "automation": {
        "status": "legacy intended-orchestration metadata; not implemented by repo_agent_server-backed MCP registrations",
        "auto_pr_creation": "identity-metadata-only",
        "auto_merge": "identity-metadata-only",
        "auto_issue_close": "identity-metadata-only",
        "continuous_mode": "identity-metadata-only",
        "health_check_interval": "identity-metadata-only"
    },
    "logging": {
        "level": "info",
        "format": "json",
        "rotation": "daily",
        "retention_days": 30
    },
    "internet_access": {
        "config_file": ".ai/configs/internet_access.json",
        "enabled": true,
        "security_mode": "strict"
    }
}
