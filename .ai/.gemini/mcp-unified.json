{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "momentum-codex": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "LOG_DIR": "logs/codex",
        "AUTO_MERGE": "identity-metadata-only",
        "YOLO_MODE": "identity-metadata-only",
        "MCP_AGENT_ROLE": "momentum-codex",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the momentum-codex identity; legacy automation labels are metadata only"
    },
    "momentum-security": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "LOG_DIR": "logs/claude",
        "AUTO_MERGE": "identity-metadata-only",
        "YOLO_MODE": "identity-metadata-only",
        "MCP_AGENT_ROLE": "momentum-security",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the momentum-security identity; legacy security and automation labels are metadata only"
    },
    "momentum-aws": {
      "command": "python3",
      "args": [".ai/mcp/scripts/repo_agent_server.py"],
      "env": {
        "LOG_DIR": "logs/amazonq",
        "AUTO_MERGE": "identity-metadata-only",
        "AWS_REGION": "identity-metadata-only",
        "MCP_AGENT_ROLE": "momentum-aws",
        "PROJECT_ROOT": "."
      },
      "description": "Read-only repository status compatibility adapter using the momentum-aws identity; legacy AWS, cloud, and automation labels are metadata only and make no external calls"
    }
  }
}
